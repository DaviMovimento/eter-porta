# Regras de cache. Funciona no Cloudflare Pages e no Netlify sem alteração.

# As páginas da revista nunca mudam depois de geradas: cacheia por um ano.
# É isto que faz a segunda visita e a rolagem para trás serem instantâneas.
/edicoes/*
  Cache-Control: public, max-age=31536000, immutable

# O catálogo e o código mudam a cada edição nova: sempre revalida.
/edicoes.json
  Cache-Control: public, max-age=0, must-revalidate
/porta.js
  Cache-Control: public, max-age=0, must-revalidate
/porta.css
  Cache-Control: public, max-age=0, must-revalidate

# Segurança básica em tudo.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
