# URLs limpas para hospedagem estática (Cloudflare Pages, Netlify).
# No domínio quem manda é o .htaccess — este arquivo é o espelho dele,
# para o dia em que a porta for servida de um CDN.
#
# Em vez de mandar "eterbrasil.com/revista/?ed=004" no Instagram, você
# manda "eterbrasil.com/revista/e/004". Cabe na bio e não parece sistema.

# a edição mora numa PASTA, não num parâmetro. A raiz virou a home, e a
# home não lê ?ed — mandar para lá era despejar toda campanha na porta
# da frente em vez da edição anunciada.
/e/:numero   /:numero/                301
/e/          /                        301

# atalhos por nome, para quando o link vai escrito num carrossel
/decada      /001/                    301
/autoral     /002/                    301
/verbo       /003/                    301
/coracoes    /004/                    301
/brasileiro  /005/                    301
/multidoes   /006/                    301
/mascaras    /007/                    301
/versos      /008/                    301

# páginas de apoio com endereço decente
/privacidade /privacidade/            200
/obrigado    /assinatura-anual/       200
/upsell      /assinatura-anual/       301
