# ═══════════════════════════════════════════════════════════════
# ROTEAMENTO DA PORTA ETER  —  pasta /revista/
#
#   eterbrasil.com/revista/           →  a home
#   eterbrasil.com/revista/007        →  a edição 007
#   eterbrasil.com/revista/e/007      →  idem (link curto de campanha)
#   eterbrasil.com/revista/mascaras   →  idem (link por nome)
#   eterbrasil.com/revista/obrigado   →  a página pós-compra
#   eterbrasil.com/revista/biblioteca →  o acervo
#
# Este arquivo estava escrito para quando a porta morava em /e/ e a RAIZ
# era a página de uma edição. Hoje a raiz é a HOME e cada edição tem a
# sua pasta. Com a `RewriteBase /e/` antiga, todo atalho por nome caía
# em /e/nome.html, que não existe: 404 silencioso em link de campanha.
# ═══════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /revista/

  # ── o upsell antigo ────────────────────────────────────────────
  # A pasta /revista/upsell/ ficou no servidor com uma cópia congelada
  # e, por ser pasta de verdade, ela vencia a regra de baixo e servia
  # texto velho. Este desvio vem ANTES da checagem de arquivo real.
  RewriteRule ^upsell/?$ /revista/assinatura-anual/ [R=301,L]

  # ── pós-compra ────────────────────────────────────────────────
  # A rota apontava para upsell.html, arquivo que não existe. Quem
  # pagava o passe caía num 404 e o anual nunca era oferecido.
  RewriteRule ^obrigado/?$ /revista/assinatura-anual/ [R=301,L]

  # arquivo ou pasta que existe de verdade é servido direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── links curtos de campanha ──────────────────────────────────
  # /revista/e/007 e /revista/e/7 → a PASTA da edição. Antes iam para
  # index.html?ed=007, e como a raiz virou a home (que não lê ?ed),
  # todo link de bio e de ManyChat desembocava na home.
  RewriteRule ^e/0*([0-9])/?$      /revista/00$1/ [R=301,L]
  RewriteRule ^e/0*([0-9]{2})/?$   /revista/0$1/  [R=301,L]
  RewriteRule ^e/([0-9]{3})/?$     /revista/$1/   [R=301,L]
  RewriteRule ^e/?$                /revista/      [R=301,L]

  # ── atalhos por nome, para carrossel e story ──────────────────
  RewriteRule ^decada/?$    /revista/001/ [R=301,L]
  RewriteRule ^autoral/?$   /revista/002/ [R=301,L]
  RewriteRule ^verbo/?$     /revista/003/ [R=301,L]
  RewriteRule ^coracoes/?$  /revista/004/ [R=301,L]
  RewriteRule ^brasileiro/?$ /revista/005/ [R=301,L]
  RewriteRule ^multidoes/?$ /revista/006/ [R=301,L]
  RewriteRule ^mascaras/?$  /revista/007/ [R=301,L]
  RewriteRule ^versos/?$    /revista/008/ [R=301,L]

  # /revista/7 → /revista/007 (a pasta com zeros à esquerda)
  RewriteRule ^0*([0-9])/?$    /revista/00$1/ [R=301,L]
  RewriteRule ^0*([0-9]{2})/?$ /revista/0$1/  [R=301,L]

  # nome solto → o .html correspondente, se ele existir
  RewriteCond %{DOCUMENT_ROOT}/revista/$1.html -f
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ $1.html [QSA,L]
</IfModule>

# o catálogo muda toda semana; o resto pode ficar guardado
<IfModule mod_headers.c>
  <FilesMatch "edicoes\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
