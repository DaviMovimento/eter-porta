# ═══════════════════════════════════════════════════════════════
# URLs LIMPAS DA PORTA ETER
#
#   eterbrasil.com/e/007          →  a edição 007
#   eterbrasil.com/e/upsell       →  a página pós-compra
#   eterbrasil.com/e/privacidade  →  a política
#
# Os links antigos com ?ed=007 continuam funcionando: nada quebra.
# Regra escopada nesta pasta — o resto do site não é afetado.
# ═══════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /e/

  # arquivo ou pasta que existe de verdade é servido direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /e/007 e /e/7 → a porta, com a edição escolhida
  RewriteRule ^0*([0-9]{1,3})/?$ index.html?ed=$1 [QSA,L]

  # /e/upsell, /e/privacidade → o arquivo .html correspondente
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ $1.html [QSA,L]
</IfModule>

# o catálogo muda toda semana; o resto pode ficar guardado
<IfModule mod_headers.c>
  <FilesMatch "edicoes\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
